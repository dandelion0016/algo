{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3StaticBucketSyncList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::algo-prod-apne1-static-hosting-ACCOUNT_ID_PLACEHOLDER"
    },
    {
      "Sid": "S3StaticBucketObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::algo-prod-apne1-static-hosting-ACCOUNT_ID_PLACEHOLDER/*"
    },
    {
      "Sid": "CloudFrontInvalidateCache",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID_PLACEHOLDER:distribution/*"
    }
  ]
}
