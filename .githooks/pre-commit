#!/bin/sh

# ==============================================================================
# Git Native Pre-Commit Hook: Staged File Syntax & Format Check
# ==============================================================================
# Validates staged JS/JSON files before commit without relying on .agents/hooks/.
# Uses project-local Prettier/ESLint if installed, otherwise zero-dependency checks.
# ==============================================================================

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged_files" ]; then
    exit 0
fi

if command -v node >/dev/null 2>&1; then
    git diff --cached --name-only --diff-filter=ACMR | node -e '
const fs = require("fs");
const cp = require("child_process");
const path = require("path");

const files = fs.readFileSync(0, "utf8").split(/\r?\n/).filter(Boolean);
const hasPrettier = fs.existsSync(path.join("node_modules", ".bin", "prettier")) ||
                    fs.existsSync(path.join("node_modules", ".bin", "prettier.cmd"));

let failed = false;
for (const file of files) {
  if (!fs.existsSync(file) || !fs.statSync(file).isFile()) continue;
  const ext = path.extname(file).toLowerCase();

  if (ext === ".json") {
    try {
      JSON.parse(fs.readFileSync(file, "utf8"));
    } catch (err) {
      console.error(`❌ [pre-commit] Invalid JSON in ${file}: ${err.message}`);
      failed = true;
    }
  } else if ([".js", ".mjs", ".cjs"].includes(ext)) {
    const res = cp.spawnSync(process.execPath, ["--check", file], { encoding: "utf8" });
    if (res.status !== 0) {
      console.error(`❌ [pre-commit] JS syntax error in ${file}:\n${res.stderr || res.stdout}`);
      failed = true;
    }
  }

  if (!failed && hasPrettier && [".js", ".mjs", ".cjs", ".ts", ".tsx", ".json", ".css", ".md", ".yml", ".yaml"].includes(ext)) {
    cp.spawnSync("npx", ["--no-install", "prettier", "--write", file], { stdio: "ignore", shell: process.platform === "win32" });
  }
}
if (failed) process.exit(1);
' || exit 1
fi

# Re-stage any files that were formatted
git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

exit 0
